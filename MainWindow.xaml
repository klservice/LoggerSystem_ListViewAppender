<Window x:Class="LoggerSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoggerSystem.Views"
        Title="BewerbungsAssiLogger – MVVM + Legacy" Width="1200" Height="760"
        MinWidth="850" MinHeight="550">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,12,4">
            <TextBlock Text="BewerbungsAssiLogger" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <!--<Button Content="Legacy Logger testen" Click="OnTestLog" Padding="12,6"
                    ToolTip="Schreibt Testeinträge über die bestehende LoggerFactory"/>-->
        </StackPanel>
        <TabControl Margin="8">
            <TabItem Header="LogViewer"><views:LogViewUserControl x:Name="LogViewer"/></TabItem>
            <TabItem Header="LoggerSettings"><views:LoggerSettingsUserControl x:Name="LoggerSettingsView"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
