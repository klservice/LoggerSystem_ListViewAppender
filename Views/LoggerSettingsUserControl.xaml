<UserControl 
    x:Class="LoggerSystem.Views.LoggerSettingsUserControl" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:providers="clr-namespace:LoggerSystem.Providers"
    MinWidth="420"
    mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="900"
    >
 <UserControl.Resources>
        <Style x:Key="GroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="85"/>
        </Style>
        
 </UserControl.Resources>
    <Grid Background="#F7F8FA" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,14,20,12">
            <TextBlock Text="Logger Settings" FontSize="23" FontWeight="SemiBold"/>
            <!--<Image Height="24" Width="24" Source="{Binding Level}"/>-->
            <TextBlock Text="log4net configuration and log folder cleanup" Foreground="DimGray"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,12">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Appender Types" MinWidth="200" Style="{StaticResource GroupStyle}">
                        <StackPanel>
                            <CheckBox Content="ListView" Margin="0,4" IsChecked="{Binding UseListView}"/>
                            <CheckBox Content="RollingFile" Margin="0,4" IsChecked="{Binding UseRollingFile}"/>
                            <CheckBox Content="Console" Margin="0,4" IsChecked="{Binding UseConsole}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="General" Style="{StaticResource GroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Minimum Log Level"/>
                            <ComboBox Width="190" HorizontalAlignment="Left" ItemsSource="{Binding AvailableLevels}" SelectedItem="{Binding MinimumLevel}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="ListView" Style="{StaticResource GroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Maximum ListView Entries"/>
                            <TextBox Width="190" HorizontalAlignment="Left" Text="{Binding MaximumListViewEntries, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,5,0,8"/>
                            <CheckBox Content="AutoScroll" IsChecked="{Binding AutoScroll}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                <GroupBox Header="Rolling Log File" Style="{StaticResource GroupStyle}">
                    <StackPanel>
                        <TextBlock Text="Log File Path"/>
                        <TextBox Text="{Binding LogFilePath, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                        <TextBlock Text="Log File Name"/>
                        <TextBox Text="{Binding LogFileName, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                        <TextBlock Text="Maximum File Size (Bytes)"/>
                        <TextBox Width="190" HorizontalAlignment="Left" Text="{Binding MaximumFileSizeBytes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,4,0,8"/>
                        <TextBlock Text="Maximum Backup Files"/>
                        <TextBox Width="190" HorizontalAlignment="Left" Text="{Binding MaximumBackupFiles, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,4,0,8"/>
                        <CheckBox Content="Append to existing log file" IsChecked="{Binding AppendToFile}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Log Folder Cleanup" Style="{StaticResource GroupStyle}">
                    <StackPanel>
                        <CheckBox Content="Clean log folder on Apply" IsChecked="{Binding CleanLogFolder}" Margin="0,4"/>
                        <CheckBox Content="Automatic cleanup at startup and daily" IsChecked="{Binding AutoCleanLogFolder}" Margin="0,4"/>
                        <TextBlock Text="Maximum Log File Age (Days)" Margin="0,8,0,0"/>
                        <TextBox Width="190" HorizontalAlignment="Left" Text="{Binding MaxLogFileAge, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Message Layout" Style="{StaticResource GroupStyle}">
                    <StackPanel>
                        <TextBlock Text="LogMessageLayoutPattern"/>
                        <TextBox Text="{Binding LogMessageLayoutPattern, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" Margin="0,6,0,4"/>
                        <TextBlock Text="%type maps to %property{type}. %C and %L may impact performance." Foreground="DimGray" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

        </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Load" Command="{Binding LoadCommand}" Padding="14,7" Margin="3"/>
    <Button Content="Reset" Command="{Binding ResetCommand}" Padding="14,7" Margin="3"/>
    <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,7" Margin="3"/>
    <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="14,7" Margin="3"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
    <ProgressBar Height="3" IsIndeterminate="True"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
   </StackPanel>
  </DockPanel>
 </Grid>
</UserControl>
