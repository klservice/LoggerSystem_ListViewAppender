<UserControl x:Class="LoggerSystem.Views.LogLevelIconSettingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="850">

    <UserControl.Resources>

        <!-- Button Style -->

        <Style x:Key="IconSettingsButtonStyle"
               TargetType="Button">

            <Setter Property="Margin" Value="3"/>

            <Setter Property="Padding" Value="10,5"/>

            <Setter Property="MinHeight" Value="28"/>

            <Setter Property="MinWidth" Value="90"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

        <!-- Image Style -->

        <Style x:Key="LogLevelImageStyle"
               TargetType="Image">

            <Setter Property="Width" Value="24"/>

            <Setter Property="Height" Value="24"/>

            <Setter Property="Margin" Value="5"/>

            <Setter Property="Stretch" Value="Uniform"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

        <!-- ListViewItem Style -->

        <Style TargetType="ListViewItem">

            <Setter Property="MinHeight" Value="38"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>

        <!-- Icon Template ohne Converter -->

        <DataTemplate x:Key="LogLevelIconTemplate">

            <Image
                Source="{Binding Icon, Mode=OneWay}"
                Style="{StaticResource LogLevelImageStyle}"/>

        </DataTemplate>

        <!-- Status Template ohne Converter -->

        <DataTemplate x:Key="IconDescriptionTemplate">

            <TextBlock
                Text="{Binding IconDescription}"
                Foreground="{Binding StatusBrush}"
                VerticalAlignment="Center"/>

        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">

            <TextBlock
                Text="LogLevel Icon Settings"
                FontSize="20"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="{Binding IconDirectory}"
                FontSize="11"
                Foreground="DimGray"
                TextWrapping="Wrap"/>

        </StackPanel>

        <!-- Icon ListView -->

        <ListView
            Grid.Row="1"
            ItemsSource="{Binding Icons}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListView.View>

                <GridView>

                    <!-- Icon -->

                    <GridViewColumn
                        Header="Icon"
                        Width="60"
                        CellTemplate="{StaticResource LogLevelIconTemplate}"/>

                    <!-- LogLevel -->

                    <GridViewColumn
                        Header="LogLevel"
                        Width="100"
                        DisplayMemberBinding="{Binding DisplayName}"/>

                    <!-- Description -->

                    <GridViewColumn
                        Header="Icon-Typ"
                        Width="180"
                        CellTemplate="{StaticResource IconDescriptionTemplate}"/>

                    <!-- Select Icon -->

                    <GridViewColumn
                        Header="Auswahl"
                        Width="125">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <Button
                                    Content="Auswählen"
                                    Style="{StaticResource IconSettingsButtonStyle}"
                                    Command="{Binding DataContext.SelectIconCommand,
                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"/>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                    <!-- Reset Icon -->

                    <GridViewColumn
                        Header="Standard"
                        Width="125">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <Button
                                    Content="Zurücksetzen"
                                    Style="{StaticResource IconSettingsButtonStyle}"
                                    Command="{Binding DataContext.ResetIconCommand,
                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"/>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                    <!-- Custom Icon Status -->

                    <GridViewColumn
                        Header="Status"
                        Width="120">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <Grid>

                                    <TextBlock
                                        Text="Standard"
                                        Foreground="DimGray"
                                        Visibility="{Binding DefaultIconVisibility}"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Text="Benutzerdefiniert"
                                        Foreground="ForestGreen"
                                        Visibility="{Binding CustomIconVisibility}"
                                        VerticalAlignment="Center"/>

                                </Grid>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                </GridView>

            </ListView.View>

        </ListView>

        <!-- Commands -->

        <WrapPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Margin="0,5">

            <Button
                Content="Neu laden"
                Style="{StaticResource IconSettingsButtonStyle}"
                Command="{Binding ReloadCommand}"/>

            <Button
                Content="Alle zurücksetzen"
                Style="{StaticResource IconSettingsButtonStyle}"
                Command="{Binding ResetAllIconsCommand}"/>

            <Button
                Content="Speichern"
                Style="{StaticResource IconSettingsButtonStyle}"
                Command="{Binding SaveCommand}"/>

        </WrapPanel>

        <!-- StatusBar -->

        <StatusBar Grid.Row="3">

            <StatusBarItem>

                <TextBlock Text="{Binding StatusMessage}"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>
</UserControl>
